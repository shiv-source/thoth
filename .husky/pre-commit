#!/bin/sh
set -e

# Generate/refresh the CodeGraph index on commit — best-effort (lib-codegraph.sh),
# a missing or failing codegraph never blocks the commit.
. scripts/lib-codegraph.sh
codegraph_ensure

# Repo rule: never commit directly to main (code-rules skill § Repo rules)
sh scripts/main-guard.sh

# CLAUDE.md and AGENTS.md are kept as exact copies — fail if they drift
if ! cmp -s CLAUDE.md AGENTS.md; then
  echo "pre-commit: CLAUDE.md and AGENTS.md differ — they must stay identical (cp one over the other)" >&2
  exit 1
fi

go_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -c '\.go$' || true)

# Go: vet + golangci-lint + tests when Go files are staged (gofmt/goimports
# and autofixes ran via lint-staged's golangci-lint --fix)
if [ "$go_staged" -gt 0 ]; then
  go vet ./...
  golangci-lint run
  go test ./...
fi

pnpm lint-staged
