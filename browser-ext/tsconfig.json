{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "esnext",
    "types": ["vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode — the build bundles with esbuild, tsc only typechecks. */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests", "e2e", "vitest.config.ts", "playwright.config.ts", "eslint.config.js"]
}
