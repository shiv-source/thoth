{
  "name": "thoth-ext",
  "private": true,
  "version": "0.1.0",
  "description": "Thoth browser extension — capture bookmarks, selections, and quick notes into the local wiki",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "antd": "6.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
