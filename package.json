{
  "name": "thoth",
  "private": true,
  "description": "Local-first personal knowledge base: a chat dashboard over a plain-markdown wiki, powered by the Claude Code CLI",
  "scripts": {
    "dev": "pnpm --filter thoth-web dev",
    "build": "pnpm --filter thoth-web build",
    "test": "pnpm --filter thoth-web test",
    "typecheck": "pnpm --filter thoth-web typecheck",
    "lint": "pnpm --filter thoth-web lint",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [
    "knowledge-base",
    "wiki",
    "markdown",
    "claude",
    "notes",
    "local-first"
  ],
  "license": "MIT",
  "author": "Thoth contributors",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/shiv-source/thoth#readme",
  "bugs": {
    "url": "https://github.com/shiv-source/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiv-source/thoth.git"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
