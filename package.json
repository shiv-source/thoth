{
  "name": "thoth",
  "private": true,
  "description": "Local-first personal knowledge base: a chat dashboard over a plain-markdown wiki, with a built-in assistant",
  "scripts": {
    "dev": "pnpm --filter thoth-web dev",
    "build": "pnpm --filter thoth-web build",
    "test": "pnpm --filter thoth-web test",
    "test:coverage": "pnpm --filter thoth-web test:coverage",
    "typecheck": "pnpm --filter thoth-web typecheck",
    "lint": "pnpm --filter thoth-web lint",
    "format": "prettier --write .",
    "docs:dev": "pnpm --filter thoth-docs start",
    "docs:build": "pnpm --filter thoth-docs build",
    "prepare": "husky"
  },
  "keywords": [
    "knowledge-base",
    "wiki",
    "markdown",
    "claude",
    "notes",
    "local-first"
  ],
  "license": "MIT",
  "author": "Thoth contributors",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/shiv-source/thoth#readme",
  "bugs": {
    "url": "https://github.com/shiv-source/thoth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiv-source/thoth.git"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6"
  }
}
