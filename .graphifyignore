# graphify ignore rules (gitignore syntax; merged with .gitignore)
# Binary and media files carry no extractable code structure and would
# be sent to the LLM during semantic extraction - exclude them here.

# Images
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.avif
*.heic
*.bmp
*.tif
*.tiff

# Documents
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# Video / audio
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.flac
*.ogg
*.m4a

# Archives
*.zip
*.tar
*.gz
*.tgz
*.bz2
*.xz
*.7z
*.rar

# Fonts
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Other binaries
*.bin
*.exe
*.dll
*.so
*.dylib
*.wasm
*.sqlite
*.sqlite3
